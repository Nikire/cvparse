{
  "name": "@cvparse/core",
  "version": "0.1.1",
  "description": "Turn CVs and resumes into typed, JSON Resume-compatible JSON using LLMs via the Vercel AI SDK. Multi-provider, Ollama/local-first, best-in-class Spanish CV support.",
  "keywords": [
    "resume",
    "cv",
    "parser",
    "json-resume",
    "llm",
    "ai-sdk",
    "ollama",
    "spanish",
    "ats",
    "recruiting"
  ],
  "author": "Nikire",
  "license": "MIT",
  "homepage": "https://github.com/Nikire/cvparse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikire/cvparse.git"
  },
  "bugs": {
    "url": "https://github.com/Nikire/cvparse/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ocr/tesseract": {
      "types": "./dist/ocr/tesseract.d.ts",
      "import": "./dist/ocr/tesseract.js",
      "default": "./dist/ocr/tesseract.js"
    },
    "./ocr/textract": {
      "types": "./dist/ocr/textract.d.ts",
      "import": "./dist/ocr/textract.js",
      "default": "./dist/ocr/textract.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cvparse": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "release:check": "npm pack --dry-run && node scripts/release-changelog.mjs --check",
    "release:patch": "npm version patch -m \"release: v%s\"",
    "release:minor": "npm version minor -m \"release: v%s\"",
    "release:major": "npm version major -m \"release: v%s\"",
    "preversion": "npm run lint && npm run typecheck && npm test",
    "version": "node scripts/release-changelog.mjs && git add CHANGELOG.md",
    "postversion": "echo Now run: git push --follow-tags",
    "fixtures:docx": "node scripts/fixtures/make-docx-fixtures.mjs",
    "fixtures:pdf": "node scripts/fixtures/make-pdf-fixtures.mjs",
    "fixtures:image": "node scripts/fixtures/make-image-fixtures.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.61",
    "ai": "^7.0.124",
    "mammoth": "^1.13.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-textract": "^3.1145.0",
    "@biomejs/biome": "^2.5.15",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^26.6.3",
    "docx": "^9.8.1",
    "pdf-lib": "^1.17.1",
    "tesseract.js": "^7.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-textract": ">=3.0.0",
    "@napi-rs/canvas": ">=0.1.0",
    "tesseract.js": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-textract": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    },
    "tesseract.js": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "ocr/tesseract": [
        "./dist/ocr/tesseract.d.ts"
      ],
      "ocr/textract": [
        "./dist/ocr/textract.d.ts"
      ]
    }
  }
}
